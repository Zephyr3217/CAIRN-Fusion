{
  "manifest_version": 3,
  "name": "CAIRN Fusion Bridge + Brain",
  "version": "0.6.5",
  "description": "CAIRN Fusion 0.6.5: connection-aware on-page UI; CAIRN controls stay hidden unless the local Bridge is connected and authorized.",
  "permissions": [
    "storage",
    "contextMenus",
    "activeTab",
    "scripting",
    "notifications"
  ],
  "host_permissions": [
    "http://127.0.0.1:7821/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "CAIRN"
  },
  "content_scripts": [
    {
      "matches": [
        "<all_urls>"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_idle",
      "css": [
        "content.css"
      ]
    }
  ],
  "commands": {
    "open-brain": {
      "suggested_key": {
        "default": "Ctrl+Shift+B"
      },
      "description": "Open CAIRN Brain"
    },
    "open-agent": {
      "suggested_key": {
        "default": "Ctrl+Shift+A"
      },
      "description": "Open CAIRN Agent"
    },
    "capture-selection": {
      "suggested_key": {
        "default": "Ctrl+Shift+S"
      },
      "description": "Capture current selection with CAIRN"
    }
  }
}
